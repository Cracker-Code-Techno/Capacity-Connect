# Database (PostgreSQL via Supabase)
# Pooled connection via PgBouncer for runtime queries
capacity_connect_POSTGRES_PRISMA_URL="postgres://user:password@host:6543/postgres?sslmode=require&pgbouncer=true"
# Direct TCP connection used for migrations & schema syncing
DIRECT_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-secure-32-character-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email Delivery (Nodemailer - e.g. Gmail with App Password)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false" # true for 465, false for other ports
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Capacity Connect <noreply@yourdomain.com>"

# Cloud File Storage (Vercel Blob)
# Optional in local dev (falls back to local public/uploads/ directory)
BLOB_READ_WRITE_TOKEN=""
